# Copy to src/.env and edit.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEVICE_MASTER_KEY=change-me-device-master-key
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# MySQL 8 (see scripts/run_mysql.sh). The database `scentstation` is created by that script.
DATABASE_URI="mysql+pymysql://root:password@127.0.0.1:3306/scentstation?charset=utf8mb4"

# First Super Admin, created automatically at start-up if it does not exist yet
SEED_SUPER_ADMIN_EMAIL=admin@scentstation.local
SEED_SUPER_ADMIN_PASSWORD=Admin@12345

# DEV ONLY: lets you fake the payment provider with POST /api/v1/dev/mock-payment
MOCK_PAYMENT_ENABLED=true

# Optional tuning
# ORDER_TTL_MINUTES=10
# COMMAND_TTL_SECONDS=120
# HEARTBEAT_ONLINE_SECONDS=60
